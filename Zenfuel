<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZenFuel Wellness — Nutrition for a Better You</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --orange: #FF5C00;
    --orange-light: #FF8A3D;
    --orange-pale: #FFF0E6;
    --dark: #1A0A00;
    --dark-soft: #2E1A0E;
    --mid: #7A4020;
    --text: #3D1F0A;
    --text-muted: #8B6347;
    --white: #FFFDF9;
    --cream: #FDF5EC;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--white);
    color: var(--text);
    overflow-x: hidden;
  }

  h1, h2, h3, h4, .brand {
    font-family: 'Syne', sans-serif;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5%;
    height: 72px;
    background: rgba(255, 253, 249, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 92, 0, 0.1);
    transition: box-shadow .3s;
  }
  nav.scrolled { box-shadow: 0 4px 32px rgba(255,92,0,0.10); }

  .brand {
    font-size: 1.45rem; font-weight: 800;
    color: var(--orange);
    letter-spacing: -0.5px;
  }
  .brand span { color: var(--dark); }

  .nav-links {
    display: flex; gap: 2rem;
    list-style: none;
  }
  .nav-links a {
    text-decoration: none;
    font-size: .9rem; font-weight: 500;
    color: var(--text);
    position: relative;
    transition: color .2s;
  }
  .nav-links a::after {
    content: '';
    position: absolute; bottom: -3px; left: 0; right: 0;
    height: 2px; background: var(--orange);
    transform: scaleX(0); transform-origin: left;
    transition: transform .25s;
  }
  .nav-links a:hover { color: var(--orange); }
  .nav-links a:hover::after { transform: scaleX(1); }

  .nav-cta {
    background: var(--orange); color: #fff;
    padding: .55rem 1.4rem;
    border-radius: 50px;
    font-size: .88rem; font-weight: 600;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
  }
  .nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,92,0,.35);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 100px 5% 60px;
    gap: 4rem;
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute; top: -200px; right: -200px;
    width: 700px; height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,92,0,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute; bottom: -100px; left: -100px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,138,61,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--orange-pale);
    color: var(--orange);
    font-size: .78rem; font-weight: 600; letter-spacing: .05em;
    text-transform: uppercase;
    padding: .4rem 1rem; border-radius: 50px;
    margin-bottom: 1.5rem;
    animation: fadeUp .6s ease both;
  }
  .hero-badge::before { content: '✦'; font-size: .7rem; }

  .hero h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 800; line-height: 1.07;
    letter-spacing: -1.5px;
    color: var(--dark);
    animation: fadeUp .6s .1s ease both;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--orange);
    position: relative;
  }
  .hero h1 em::after {
    content: '';
    position: absolute; left: 0; bottom: 2px; right: 0;
    height: 6px;
    background: rgba(255,92,0,0.18);
    border-radius: 3px;
  }

  .hero p {
    margin: 1.5rem 0 2.5rem;
    font-size: 1.08rem; line-height: 1.7;
    color: var(--text-muted);
    max-width: 460px;
    animation: fadeUp .6s .2s ease both;
  }

  .hero-actions {
    display: flex; gap: 1rem; flex-wrap: wrap;
    animation: fadeUp .6s .3s ease both;
  }

  .btn-primary {
    background: var(--orange); color: #fff;
    padding: .85rem 2rem; border-radius: 50px;
    font-size: .95rem; font-weight: 600;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
    display: inline-block;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(255,92,0,.35);
  }

  .btn-ghost {
    background: transparent; color: var(--text);
    padding: .85rem 2rem; border-radius: 50px;
    font-size: .95rem; font-weight: 500;
    text-decoration: none;
    border: 1.5px solid rgba(0,0,0,0.15);
    transition: border-color .2s, color .2s;
    display: inline-block;
  }
  .btn-ghost:hover { border-color: var(--orange); color: var(--orange); }

  .hero-stats {
    display: flex; gap: 2.5rem; margin-top: 3rem;
    animation: fadeUp .6s .4s ease both;
  }
  .stat-item h3 {
    font-size: 1.9rem; font-weight: 800;
    color: var(--orange);
  }
  .stat-item p {
    font-size: .82rem; color: var(--text-muted);
    margin: 0;
  }

  .hero-visual {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    animation: fadeIn .8s .2s ease both;
  }

  .hero-card-stack {
    position: relative; width: 360px; height: 460px;
  }

  .product-card-hero {
    position: absolute;
    background: #fff;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.10);
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }

  .card-main {
    width: 280px; top: 50%; left: 50%; transform: translate(-50%, -50%);
    background: linear-gradient(145deg, #fff 0%, #FFF5EE 100%);
    padding: 2.5rem 2rem;
    z-index: 3;
  }
  .card-back-1 {
    width: 260px; top: 52%; left: calc(50% + 30px);
    transform: translate(-50%, -50%) rotate(8deg);
    background: linear-gradient(145deg, #FF8A3D22, #FF5C0011);
    z-index: 2; height: 200px;
  }
  .card-back-2 {
    width: 260px; top: 52%; left: calc(50% - 30px);
    transform: translate(-50%, -50%) rotate(-6deg);
    background: linear-gradient(145deg, #FFD0B022, #FF5C0011);
    z-index: 1; height: 200px;
  }

  .product-emoji {
    font-size: 4.5rem; margin-bottom: .75rem;
    filter: drop-shadow(0 6px 12px rgba(255,92,0,0.2));
  }
  .card-main h3 { font-size: 1.1rem; font-weight: 700; color: var(--dark); }
  .card-main p { font-size: .82rem; color: var(--text-muted); margin: .4rem 0 1rem; }
  .card-tag {
    background: var(--orange-pale); color: var(--orange);
    font-size: .73rem; font-weight: 600;
    padding: .3rem .8rem; border-radius: 50px;
  }

  .floating-badge {
    position: absolute;
    background: #fff;
    border-radius: 14px;
    padding: .7rem 1rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    display: flex; align-items: center; gap: .6rem;
    font-size: .8rem; font-weight: 600;
    z-index: 10;
    animation: float 3s ease-in-out infinite;
  }
  .badge-stars { top: 18%; right: -10px; animation-delay: 0s; }
  .badge-users { bottom: 22%; left: -20px; animation-delay: 1.2s; }

  .badge-icon { font-size: 1.2rem; }

  /* ── GOALS SECTION ── */
  .section { padding: 100px 5%; }
  .section-label {
    display: inline-block;
    font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--orange);
    margin-bottom: .75rem;
  }
  .section-title {
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 800; letter-spacing: -1px;
    color: var(--dark); line-height: 1.15;
    margin-bottom: 1rem;
  }
  .section-sub {
    font-size: 1rem; color: var(--text-muted); line-height: 1.7;
    max-width: 500px;
  }

  .goals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .goal-card {
    background: var(--cream);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: transform .25s, box-shadow .25s, background .25s;
    border: 1.5px solid transparent;
  }
  .goal-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(255,92,0,0.12);
    background: #fff;
    border-color: rgba(255,92,0,0.2);
  }
  .goal-icon {
    font-size: 2.8rem; margin-bottom: 1rem;
    display: block;
    transition: transform .25s;
  }
  .goal-card:hover .goal-icon { transform: scale(1.15); }
  .goal-card h3 { font-size: 1rem; font-weight: 700; color: var(--dark); margin-bottom: .4rem; }
  .goal-card p { font-size: .83rem; color: var(--text-muted); line-height: 1.5; }

  /* ── PRODUCTS ── */
  .products-bg { background: var(--dark); }
  .products-bg .section-title { color: #fff; }
  .products-bg .section-sub { color: rgba(255,255,255,0.55); }
  .products-bg .section-label { color: var(--orange-light); }

  .products-tabs {
    display: flex; gap: .75rem; margin: 2.5rem 0;
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: .55rem 1.4rem; border-radius: 50px;
    font-size: .85rem; font-weight: 500;
    cursor: pointer; border: none;
    background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6);
    font-family: 'DM Sans', sans-serif;
    transition: background .2s, color .2s;
  }
  .tab-btn.active, .tab-btn:hover {
    background: var(--orange); color: #fff;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .product-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 2rem;
    transition: transform .25s, background .25s, border-color .25s;
    cursor: pointer;
  }
  .product-card:hover {
    transform: translateY(-5px);
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,92,0,0.4);
  }
  .product-emoji-lg { font-size: 3.5rem; margin-bottom: 1rem; display: block; }
  .product-category {
    font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--orange-light); margin-bottom: .5rem;
  }
  .product-card h3 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: .5rem; }
  .product-card p { font-size: .84rem; color: rgba(255,255,255,0.5); line-height: 1.5; }
  .product-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .product-price { font-size: 1.05rem; font-weight: 700; color: var(--orange-light); font-family: 'Syne', sans-serif; }
  .add-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--orange); color: #fff;
    border: none; font-size: 1.3rem;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: transform .2s, box-shadow .2s;
  }
  .add-btn:hover { transform: scale(1.15); box-shadow: 0 4px 16px rgba(255,92,0,.5); }

  /* ── HOW IT WORKS ── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2rem; margin-top: 3.5rem;
    position: relative;
  }
  .steps-grid::before {
    content: '';
    position: absolute; top: 48px; left: 16%; right: 16%;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--orange) 0, var(--orange) 8px, transparent 8px, transparent 16px);
    opacity: 0.4;
  }

  .step-card { text-align: center; padding: 2rem 1.5rem; }
  .step-number {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--orange-pale);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem;
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem; font-weight: 800; color: var(--orange);
    border: 3px solid rgba(255,92,0,0.15);
    position: relative; z-index: 1;
  }
  .step-card h3 { font-size: 1.05rem; font-weight: 700; color: var(--dark); margin-bottom: .5rem; }
  .step-card p { font-size: .86rem; color: var(--text-muted); line-height: 1.6; }

  /* ── TESTIMONIALS ── */
  .testimonials-bg { background: var(--orange-pale); }

  .testimonials-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem; margin-top: 3.5rem;
  }

  .testimonial-card {
    background: #fff; border-radius: 20px;
    padding: 2rem;
    transition: transform .25s, box-shadow .25s;
  }
  .testimonial-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(255,92,0,0.1);
  }

  .stars { color: var(--orange); font-size: 1rem; margin-bottom: 1rem; letter-spacing: 2px; }
  .testimonial-card p { font-size: .9rem; line-height: 1.7; color: var(--text); font-style: italic; margin-bottom: 1.25rem; }
  .reviewer { display: flex; align-items: center; gap: .75rem; }
  .reviewer-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--orange), var(--orange-light));
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; color: #fff; font-size: .95rem;
  }
  .reviewer-name { font-weight: 600; font-size: .88rem; color: var(--dark); }
  .reviewer-meta { font-size: .77rem; color: var(--text-muted); }

  /* ── OPPORTUNITY ── */
  .opportunity {
    background: linear-gradient(135deg, var(--orange) 0%, #E04400 100%);
    padding: 100px 5%;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
    position: relative; overflow: hidden;
  }
  .opportunity::before {
    content: '';
    position: absolute; top: -100px; right: -100px;
    width: 500px; height: 500px; border-radius: 50%;
    background: rgba(255,255,255,0.06);
  }
  .opportunity::after {
    content: '';
    position: absolute; bottom: -80px; left: 10%;
    width: 300px; height: 300px; border-radius: 50%;
    background: rgba(0,0,0,0.06);
  }

  .opportunity h2 { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -1px; }
  .opportunity p { font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 1.5rem 0 2.5rem; }
  .btn-white {
    background: #fff; color: var(--orange);
    padding: .9rem 2.2rem; border-radius: 50px;
    font-size: .95rem; font-weight: 700;
    text-decoration: none; display: inline-block;
    transition: transform .2s, box-shadow .2s;
  }
  .btn-white:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.15); }

  .opp-features { display: flex; flex-direction: column; gap: 1.25rem; }
  .opp-feature {
    display: flex; align-items: flex-start; gap: 1rem;
    background: rgba(255,255,255,0.1);
    border-radius: 16px; padding: 1.25rem 1.5rem;
    border: 1px solid rgba(255,255,255,0.15);
    transition: background .2s;
  }
  .opp-feature:hover { background: rgba(255,255,255,0.15); }
  .opp-feat-icon { font-size: 1.8rem; flex-shrink: 0; }
  .opp-feature h4 { font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: .25rem; }
  .opp-feature p { font-size: .82rem; color: rgba(255,255,255,0.7); line-height: 1.5; margin: 0; }

  /* ── FOOTER ── */
  footer {
    background: var(--dark);
    padding: 70px 5% 30px;
  }
  .footer-top {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem; margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .footer-brand .brand { font-size: 1.4rem; }
  .footer-brand p { font-size: .85rem; color: rgba(255,255,255,0.45); line-height: 1.7; margin: 1rem 0 1.5rem; max-width: 280px; }

  .social-links { display: flex; gap: .75rem; }
  .social-link {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem; text-decoration: none;
    transition: background .2s;
    color: rgba(255,255,255,0.5);
  }
  .social-link:hover { background: var(--orange); color: #fff; }

  .footer-col h4 { font-size: .88rem; font-weight: 700; color: #fff; margin-bottom: 1.2rem; }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .6rem; }
  .footer-col ul a { text-decoration: none; font-size: .83rem; color: rgba(255,255,255,0.45); transition: color .2s; }
  .footer-col ul a:hover { color: var(--orange-light); }

  .footer-bottom {
    display: flex; align-items: center; justify-content: space-between;
    font-size: .78rem; color: rgba(255,255,255,0.3);
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0; transform: translateY(32px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.visible { opacity: 1; transform: none; }

  /* ── MOBILE ── */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 100px; }
    .hero-visual { display: none; }
    .goals-grid { grid-template-columns: repeat(2, 1fr); }
    .products-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-grid { grid-template-columns: 1fr; }
    .steps-grid::before { display: none; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .opportunity { grid-template-columns: 1fr; }
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .goals-grid { grid-template-columns: 1fr; }
    .products-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
    .footer-top { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav id="mainNav">
  <div class="brand">ZenFuel <span>Wellness</span></div>
  <ul class="nav-links">
    <li><a href="#goals">Goals</a></li>
    <li><a href="#products">Products</a></li>
    <li><a href="#how">How It Works</a></li>
    <li><a href="#opportunity">Business</a></li>
  </ul>
  <a href="#contact" class="nav-cta">Get Started</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">Trusted by 10,000+ Happy Customers</div>
    <h1>Fuel Your Body.<br><em>Transform</em> Your Life.</h1>
    <p>Premium nutrition solutions crafted for weight management, energy, fitness, and total wellness — tailored for India's active lifestyle.</p>
    <div class="hero-actions">
      <a href="#products" class="btn-primary">Explore Products</a>
      <a href="#how" class="btn-ghost">How It Works</a>
    </div>
    <div class="hero-stats">
      <div class="stat-item"><h3>10K+</h3><p>Active Members</p></div>
      <div class="stat-item"><h3>40+</h3><p>Products</p></div>
      <div class="stat-item"><h3>98%</h3><p>Satisfaction Rate</p></div>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-card-stack">
      <div class="product-card-hero card-back-2"></div>
      <div class="product-card-hero card-back-1"></div>
      <div class="product-card-hero card-main">
        <span class="product-emoji">🥤</span>
        <h3>Protein Meal Shake</h3>
        <p>Rich in protein, 21 vitamins & minerals</p>
        <span class="card-tag">Best Seller</span>
      </div>
      <div class="floating-badge badge-stars">
        <span class="badge-icon">⭐</span>
        <div><strong>4.9/5</strong><br><span style="font-size:.7rem;color:#999">2,400 Reviews</span></div>
      </div>
      <div class="floating-badge badge-users">
        <span class="badge-icon">👥</span>
        <div><strong>+240 this week</strong><br><span style="font-size:.7rem;color:#999">Joined ZenFuel</span></div>
      </div>
    </div>
  </div>
</section>

<!-- GOALS -->
<section class="section" id="goals">
  <div class="reveal">
